 src/soup_cli/commands/ship.py      |  23 ++++
 src/soup_cli/utils/adapter_diff.py |  29 +++++
 src/soup_cli/utils/ship_verdict.py |  25 ++++
 tests/test_ship_adapter_noop.py    | 177 +++++++++++++++++++++++++++++
 5 files changed, 261 insertions(+)
