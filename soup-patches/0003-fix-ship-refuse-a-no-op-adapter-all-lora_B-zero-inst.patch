 FAILED_REGRESSION = "regression"  # leg 2: a general benchmark regressed
+FAILED_ADAPTER_NOOP = "adapter_noop"  # every lora_B is zero: tuned == base
 
 # Default forgetting threshold — 0.05 ABSOLUTE points, mirroring
 # ``EvalGateConfig.regression_threshold`` and ``run_gate`` semantics.
@@ -525,6 +526,24 @@ def decide_ship(
     )
 
 
+def adapter_noop_verdict(
+    task_mode: str, *, forgetting_threshold: float = DEFAULT_FORGETTING_THRESHOLD
+) -> ShipVerdict:
+    """DON'T SHIP for an adapter whose ``lora_B`` tensors are all zero.
+
+    Decided from the weights alone, before any model load, so the scores are
+    placeholders (0.0 -> 0.0, no win, no benchmarks), not measurements.
+    """
+    return ShipVerdict(
+        decision=DECISION_DONT_SHIP,
+        task_win=TaskWin(mode=task_mode, base=0.0, tuned=0.0, won=False),
+        benchmark_deltas=(),
+        failed_rule=FAILED_ADAPTER_NOOP,
+        forgetting_threshold=_validate_threshold(forgetting_threshold),
+        soup_version=__version__,
+    )
+
+
 # ---------------------------------------------------------------------------
 # Reason strings (shared by rubric + panel)
 # ---------------------------------------------------------------------------
@@ -540,6 +559,12 @@ def _failed_rule_explanation(verdict: ShipVerdict) -> str:
             "Task improved AND no general benchmark regressed past "
             f"{verdict.forgetting_threshold:.2%}."
         )
