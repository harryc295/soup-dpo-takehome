+                task_mode, forgetting_threshold=forgetting_threshold
+            )
+
     tuned_id = tuned if tuned else base
     try:
         base_gen, tuned_gen = _resolve_generators(base, tuned, adapter, device, quantization)
diff --git a/src/soup_cli/utils/adapter_diff.py b/src/soup_cli/utils/adapter_diff.py
index 2dc7354..e5cba63 100644
--- a/src/soup_cli/utils/adapter_diff.py
+++ b/src/soup_cli/utils/adapter_diff.py
@@ -240,6 +240,35 @@ def load_adapter_weights(adapter_dir: str) -> Mapping[str, Any]:
     return _load_safetensors(path)
 
 
+def lora_b_all_zero(adapter_dir: str) -> Optional[int]:
+    """Count of ``lora_B`` tensors if EVERY one is exactly zero, else ``None``.
+
+    PEFT initialises ``lora_B`` to zero, so an adapter whose B matrices are all
+    zero adds nothing to the base weights (tuned == base). ``None`` also covers
+    "cannot tell": no weights file, or no ``lora_B`` keys (VeRA / other PEFT
+    types, where zero B does not mean the same thing).
+
+    Tensors are streamed one at a time via torch (numpy cannot read bfloat16,
+    the usual adapter dtype), and only the ``lora_B`` ones are materialised.
+    """
+    try:
+        path = _adapter_weights_path(Path(adapter_dir))
+    except FileNotFoundError:
+        return None
+    import torch
+    from safetensors import safe_open
+
+    count = 0
+    with safe_open(str(path), framework="pt") as handle:
+        for key in handle.keys():
+            if ".lora_B." not in key and not key.endswith(".lora_B"):
+                continue
+            if torch.count_nonzero(handle.get_tensor(key)).item() != 0:
+                return None
+            count += 1
+    return count or None
+
+
 def _effective_rank_average(weights: Mapping[str, Any]) -> Optional[float]:
     """Mean effective-rank across 2D LoRA matrices (None if no 2D tensors)."""
     import numpy as np
