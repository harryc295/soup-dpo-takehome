diff --git a/tests/test_ship_adapter_noop.py b/tests/test_ship_adapter_noop.py
new file mode 100644
index 0000000..032d613
--- /dev/null
+++ b/tests/test_ship_adapter_noop.py
@@ -0,0 +1,177 @@
+"""``soup ship --adapter`` refuses a no-op adapter (every ``lora_B`` tensor zero).
+
+PEFT initialises ``lora_B`` to zero, so an adapter whose B matrices are all zero
+adds nothing to the base weights: tuned == base. That is what a run whose
+optimizer never stepped saves, and what TRL's DPO trainer writes to its ``ref/``
+sub-adapter. Ship used to reject it only indirectly ("task did not improve"),
+which misreports the cause. The check reads the weights file BEFORE any model
+load, so the generator factory must never be reached.
+"""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+from safetensors.numpy import save_file
+from typer.testing import CliRunner
+
+from soup_cli.commands import ship as ship_cmd
+from soup_cli.utils import live_eval
+
+_A = "base_model.model.layers.0.self_attn.q_proj.lora_A.weight"
+_B = "base_model.model.layers.0.self_attn.q_proj.lora_B.weight"
+_A2 = "base_model.model.layers.1.self_attn.q_proj.lora_A.weight"
+_B2 = "base_model.model.layers.1.self_attn.q_proj.lora_B.weight"
+
+
+def _write_adapter(directory: Path, tensors: dict) -> None:
+    directory.mkdir(parents=True, exist_ok=True)
+    save_file(tensors, str(directory / "adapter_model.safetensors"))
+    (directory / "adapter_config.json").write_text(
+        json.dumps({"peft_type": "LORA", "r": 4}), encoding="utf-8"
+    )
+
+
+def _lora_b_all_zero(adapter_dir: str):
+    # Imported lazily so a missing helper fails these tests, not collection.
+    from soup_cli.utils.adapter_diff import lora_b_all_zero
+
+    return lora_b_all_zero(adapter_dir)
+
+
+def _rand(*shape: int) -> np.ndarray:
+    return np.random.default_rng(0).standard_normal(shape).astype(np.float32)
+
+
+def _zero_b_tensors() -> dict:
+    return {
+        _A: _rand(4, 8), _B: np.zeros((8, 4), np.float32),
+        _A2: _rand(4, 8), _B2: np.zeros((8, 4), np.float32),
+    }
+
+
+def _invoke(runner: CliRunner, *extra: str):
+    Path("task.jsonl").write_text(
+        json.dumps({"prompt": "say hi", "expected": "hi", "scoring": "contains"}) + "\n",
+        encoding="utf-8",
+    )
+    return runner.invoke(
+        ship_cmd.app,
+        ["--base", "m", "--adapter", "ad", "--task-eval", "task.jsonl",
+         "--device", "cpu", *extra],
+    )
+
+
+@pytest.fixture
+def factory_calls(monkeypatch):
+    """Record every generator build; a no-op adapter must produce none."""
+    calls: list = []
+
+    def _fake(*args, **kwargs):
+        calls.append((args, kwargs))
+        return lambda prompt: "hi"
+
+    monkeypatch.setattr(live_eval, "make_generator", _fake)
+    return calls
+
+
+class TestLoraBAllZero:
+    def test_counts_zero_b_tensors(self, tmp_path):
+        _write_adapter(tmp_path / "ad", _zero_b_tensors())
+        assert _lora_b_all_zero(str(tmp_path / "ad")) == 2
+
+    def test_none_when_any_b_is_nonzero(self, tmp_path):
+        tensors = _zero_b_tensors()
+        tensors[_B2] = _rand(8, 4)
+        _write_adapter(tmp_path / "ad", tensors)
+        assert _lora_b_all_zero(str(tmp_path / "ad")) is None
+
+    def test_none_without_lora_b_keys(self, tmp_path):
+        # VeRA / other PEFT types: do not guess.
+        _write_adapter(tmp_path / "ad", {
+            "base_model.model.l0.vera_lambda_b": np.zeros(4, np.float32),
+            "base_model.model.l0.vera_lambda_d": _rand(4),
+        })
+        assert _lora_b_all_zero(str(tmp_path / "ad")) is None
+
+    def test_none_when_weights_missing(self, tmp_path):
+        assert _lora_b_all_zero(str(tmp_path / "does-not-exist")) is None
+
+    def test_bfloat16_zero_b(self, tmp_path):
+        torch = pytest.importorskip("torch")
+        from safetensors.torch import save_file as save_torch
+
+        d = tmp_path / "ad"
+        d.mkdir()
+        save_torch(
+            {_A: torch.randn(4, 8).bfloat16(), _B: torch.zeros(8, 4).bfloat16()},
+            str(d / "adapter_model.safetensors"),
+        )
+        assert _lora_b_all_zero(str(d)) == 1
+
+
+class TestShipRefusesNoopAdapter:
+    def test_zero_b_adapter_is_dont_ship_without_loading_a_model(
+        self, tmp_path, monkeypatch, factory_calls
+    ):
+        monkeypatch.chdir(tmp_path)
+        _write_adapter(tmp_path / "ad", _zero_b_tensors())
+        res = _invoke(
+            CliRunner(), "-o", "verdict.json", "--emit-evidence", "evidence.json"
+        )
+
+        assert res.exit_code == 2, (res.output, repr(res.exception))
+        assert factory_calls == []
+        verdict = json.loads((tmp_path / "verdict.json").read_text(encoding="utf-8"))
+        assert verdict["decision"] == "DON'T SHIP"
+        assert verdict["failed_rule"] == "adapter_noop"
+        assert (tmp_path / "evidence.json").exists()
+        assert "no-op" in res.output
+        assert "2 lora_B" in res.output
+
+    def test_nonzero_b_adapter_passes_through_to_normal_path(
+        self, tmp_path, monkeypatch, factory_calls
+    ):
+        monkeypatch.chdir(tmp_path)
+        tensors = _zero_b_tensors()
+        tensors[_B] = _rand(8, 4)
+        _write_adapter(tmp_path / "ad", tensors)
+        res = _invoke(CliRunner(), "-o", "verdict.json")
+
+        assert len(factory_calls) == 2, res.output  # base + tuned were built
+        verdict = json.loads((tmp_path / "verdict.json").read_text(encoding="utf-8"))
+        assert verdict["failed_rule"] != "adapter_noop"
+
+    def test_adapter_without_lora_b_keys_skips_the_check(
+        self, tmp_path, monkeypatch, factory_calls
+    ):
+        monkeypatch.chdir(tmp_path)
+        _write_adapter(tmp_path / "ad", {
+            "base_model.model.l0.vera_lambda_b": np.zeros(4, np.float32),
+        })
+        res = _invoke(CliRunner(), "-o", "verdict.json")
+
+        assert len(factory_calls) == 2, res.output
+        verdict = json.loads((tmp_path / "verdict.json").read_text(encoding="utf-8"))
+        assert verdict["failed_rule"] != "adapter_noop"
+
+    def test_tuned_model_path_is_never_checked(
+        self, tmp_path, monkeypatch, factory_calls
+    ):
+        # --tuned is a full model; an unrelated zero-B adapter dir must not matter.
+        monkeypatch.chdir(tmp_path)
+        _write_adapter(tmp_path / "ad", _zero_b_tensors())
+        Path("task.jsonl").write_text(
+            json.dumps({"prompt": "p", "expected": "hi", "scoring": "contains"}) + "\n",
+            encoding="utf-8",
+        )
+        res = CliRunner().invoke(
+            ship_cmd.app,
+            ["--base", "m", "--tuned", "ad", "--task-eval", "task.jsonl",
+             "--device", "cpu", "-o", "verdict.json"],
+        )
+        verdict = json.loads((tmp_path / "verdict.json").read_text(encoding="utf-8"))
+        assert verdict["failed_rule"] != "adapter_noop", res.output
